# Shared admin token for FastAPI and protected Node relay routes.
# Use a long random value; enter it when the local browser prompts.
CIRCUX_ADMIN_TOKEN=replace-with-a-long-random-token
CIRCUX_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CIRCUX_DATA_DIR=.circux-data

# Node relay listener (use 0.0.0.0 only on a trusted private network).
CIRCUX_RELAY_HOST=0.0.0.0

# Optional existing Node relay/device settings
CIRCUX_DEVICE_KEY=replace-with-a-device-key
# Physical commands are disabled by default. Keep false until safety interlocks are validated.
CIRCUX_ENABLE_HARDWARE_COMMANDS=false
