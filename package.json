{
  "name": "circux-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:display": "next dev -p 3001",
    "exhibition": "node scripts/run-exhibition.js",
    "backend": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "auto-push": "powershell -ExecutionPolicy Bypass -File scripts/auto-push.ps1",
    "build": "next build",
    "start": "next start",
    "test:relay": "node scripts/test-relay.js",
    "test:uploads": "node scripts/test-upload-policy.js",
    "log:activity": "powershell -ExecutionPolicy Bypass -File scripts/log-activity.ps1",
    "typecheck": "tsc --noEmit",
    "test:search": "node scripts/test-search-coverage.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
